APP_HOST=0.0.0.0
APP_PORT=10000

# XXX: make sure this matches your domain
DOMAIN=example.com

# XXX: make sure these match your db credentials
DB_USER=cmyui
DB_PASS=lol123
DB_NAME=banchopy
DB_HOST=mysql
DB_PORT=3306
DB_USE_SSL=false

REDIS_USER=default
REDIS_PASS=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# XXX: this is required for beatmaps
OSU_API_KEY=

# XXX: make sure this is a safe place for
# bancho.py to store all of it's data
DATA_DIRECTORY=/home/user/bancho.py/.data

# XXX: make sure these match your cert paths
SSL_CERT_PATH=/home/user/certs/fullchain.crt
SSL_KEY_PATH=/home/user/certs/private.key

# Chimu: https://api.chimu.moe/cheesegull/search - https://api.chimu.moe/v1/download
# osu.direct: https://osu.direct/api/search - https://osu.direct/d
MIRROR_SEARCH_ENDPOINT=https://catboy.best/api/search
MIRROR_DOWNLOAD_ENDPOINT=https://catboy.best/d

COMMAND_PREFIX=!

SEASONAL_BGS=https://i.cmyui.xyz/T74WiQG5wVyf.jpg,https://i.cmyui.xyz/nrMT4V2RR3PR.jpeg

MENU_ICON_URL=https://akatsuki.pw/static/images/logos/logo_ingame.png
MENU_ONCLICK_URL=https://akatsuki.pw

DATADOG_API_KEY=
DATADOG_APP_KEY=

DEBUG=False

# redirect beatmaps, beatmapsets, and forum
# pages of maps to the official osu! website
REDIRECT_OSU_URLS=True

PP_CACHED_ACCS=90,95,98,99,100

DISALLOWED_NAMES=mrekk,vaxei,btmc,cookiezi
DISALLOWED_PASSWORDS=password,abc123
DISALLOW_OLD_CLIENTS=True
DISALLOW_INGAME_REGISTRATION=True

# captcha verification for web (v2 api) registration.
# one of: recaptcha, hcaptcha, turnstile (empty = disabled)
CAPTCHA_PROVIDER=
CAPTCHA_SECRET=

# whether web session cookies are marked Secure (https-only).
# only disable this for plain-http local development.
WEB_SESSION_COOKIE_SECURE=True

DISCORD_AUDIT_LOG_WEBHOOK=
# optional: a Discord webhook URL that receives an embed each time a player
# takes #1 on a ranked leaderboard. Leave empty to disable the feed.
DISCORD_FIRST_PLACE_WEBHOOK=
DISCORD_INVITE=https://discord.gg/ShEQgUx

# optional: Discord OAuth2 account linking. Create an application at
# https://discord.com/developers/applications, add the redirect URI there, and
# fill all three in. Leave any of them empty to disable linking. The redirect URI
# must point at this server's /v2/oauth/discord/callback and match exactly.
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=

# optional: host beatmaps uploaded to this server (rather than only mirroring
# osu!'s). Off by default -- turning it on opens a file-upload endpoint, so it is
# an explicit opt-in. Players POST an .osz to /v2/beatmaps/submissions; hosted
# maps get ids from 2,000,000,000 up, well clear of osu!'s own id space.
#
# Uploads start Unranked and invisible to other players. Staff review them, and
# only staff can give a hosted map a status that awards pp.
BEATMAP_SUBMISSION_ENABLED=False
# per-upload limits. The uncompressed cap is checked against the archive's own
# declared sizes before anything is decompressed, so a "zip bomb" is refused
# without being expanded.
BEATMAP_SUBMISSION_MAX_ARCHIVE_MB=64
BEATMAP_SUBMISSION_MAX_UNCOMPRESSED_MB=192
BEATMAP_SUBMISSION_MAX_MEMBERS=500
BEATMAP_SUBMISSION_MAX_COMPRESSION_RATIO=200.0
BEATMAP_SUBMISSION_MAX_OSU_FILE_MB=4
BEATMAP_SUBMISSION_MAX_DIFFICULTIES=64
# how many beatmap sets one account may host at once.
BEATMAP_SUBMISSION_MAX_PER_USER=20

# automatically share information with the primary
# developer of bancho.py (https://github.com/cmyui)
# for debugging & development purposes.
AUTOMATICALLY_REPORT_PROBLEMS=False

LOG_WITH_COLORS=False

# error tracking. leave empty to disable.
SENTRY_DSN=

# bearer token required to scrape /metrics. empty = endpoint disabled.
# generate one with `openssl rand -hex 24`.
METRICS_TOKEN=

# --- client IP resolution ----------------------------------------------
# Comma-separated IPs/CIDRs of reverse proxies you control.
#
# `X-Forwarded-For`, `X-Real-IP` and `CF-Connecting-IP` are only honored
# when a request arrives from one of these -- otherwise any client could
# forge its own IP (spoofing geolocation, hardware matching, and bans).
#
# The default covers the common case of nginx/caddy on the same host.
# Behind Cloudflare, add Cloudflare's published ranges. In docker, add
# your bridge network (e.g. 172.16.0.0/12).
TRUSTED_PROXIES=127.0.0.1,::1

# --- connection tuning -------------------------------------------------
# these have sane defaults; override only if you know why.
#
# outbound http (beatmap mirrors, osu!api, geolocation, webhooks).
# without timeouts a hung upstream blocks a request indefinitely.
HTTP_CONNECT_TIMEOUT=5.0
HTTP_READ_TIMEOUT=15.0
HTTP_WRITE_TIMEOUT=15.0
HTTP_POOL_TIMEOUT=5.0
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
HTTP_RETRIES=2

REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5.0
REDIS_CONNECT_TIMEOUT=5.0
REDIS_HEALTH_CHECK_INTERVAL=30

# how long to let in-flight requests finish on shutdown.
SHUTDOWN_DRAIN_TIMEOUT=15.0

# retry/backoff when mysql or redis are not yet accepting connections
# (e.g. after a host reboot).
STARTUP_CONNECT_ATTEMPTS=10
STARTUP_CONNECT_MAX_WAIT=10.0

# if you are using cloudflared you NEED to configure this!
TUNNEL_TOKEN=CloudflaredTunnelToken

# XXX: Uncomment this if you have downloaded the database from maxmind.
# Change the path to the .mmdb file you downloaded, uncomment here and in docker-compose.yml
# You can download the database here: https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
#MMD_DB_PATH=/home/user/misc/GeoLite2-City.mmdb

# advanced dev settings

## WARNING: only touch this once you've
##          read through what it enables.
##          you could put your server at risk.
DEVELOPER_MODE=False

# backups (scripts/backup.sh). These have sane defaults and are only here for
# discoverability; override to send backups off the app's own disk.
# BACKUP_DIR=/mnt/backups        # where dumps, binlogs, and replay snapshots land
# RETENTION_DAYS=14              # prune artefacts older than this
